# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env.local and fill in real values
# See SETUP.md §4 for full documentation of each variable
# NEVER commit .env.local or any real credentials
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Client Config (safe to expose — NEXT_PUBLIC_* vars) ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# ── Ad Networks — public zone/site IDs only (safe to expose) ─────────────────
NEXT_PUBLIC_ADSTERRA_ZONE_HEADER=your-adsterra-header-zone-id
NEXT_PUBLIC_ADSTERRA_ZONE_NATIVE=your-adsterra-native-zone-id
NEXT_PUBLIC_MEDIANET_SITE_ID=your-medianet-site-id

# ── Public Social Channel Links ───────────────────────────────────────────────
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/karavali_jobs_channel
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/your-channel-id

# ── Site URL (used for metadataBase in root layout) ──────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Firebase Admin SDK — SERVER-SIDE ONLY (do NOT prefix with NEXT_PUBLIC_) ──
# Used in Next.js route handlers that require elevated access
# Cloud Functions use their own admin initialisation in functions/
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key contains literal \n — replace with actual newlines in .env.local
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
