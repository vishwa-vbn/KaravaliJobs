# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Firebase ──────────────────────────────────────────────────────────────────
# Service account JSON files — NEVER commit these (SETUP.md §4)
*service-account*.json
*serviceAccount*.json
*-service-account.json
firebase-debug.log
firebase-debug.*.log
.firebase/

# Cloud Functions compiled output and secrets
functions/lib/
functions/node_modules/
functions/.env
functions/.env.*
!functions/.env.example

# .env.local and any real env files (template is safe — .env.example is committed)
.env.local
.env.development.local
.env.test.local
.env.production.local
# Note: .env* already covers most of the above — keeping explicit entries for clarity

# Scratch directory (development scripts)
/scratch/

