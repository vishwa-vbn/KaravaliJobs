# ─────────────────────────────────────────────────────────────────────────────
# functions/.env.example — copy to functions/.env and fill in real values
# These are Cloud Functions environment variables (v2 functions use .env files)
# See SETUP.md §4 "Cloud Functions env" section
# NEVER commit functions/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Brevo Transactional Email (Phase 2) ──────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=jobs@your-domain.com

# ── Telegram Bot (Phase 4) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=@UdupiMangaloreJobs

# ── WhatsApp Cloud API (Phase 2 — leave blank until Meta Business verified) ──
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Instagram Graph API (Phase 2/3 — leave blank until Meta App Review granted) ──
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Admin Telegram Chat (manual-post fallback for Instagram before API ready) ─
ADMIN_NOTIFY_TELEGRAM_CHAT_ID=your-admin-chat-id
